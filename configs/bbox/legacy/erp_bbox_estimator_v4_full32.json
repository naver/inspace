{
    "models": {
        "bbox_estimator": {
            "name": "BBoxEstimator",
            "args": {
                "voxel_resolution": 64,
                "d_model": 256,
                "nhead": 8,
                "num_decoder_layers": 6,
                "dim_feedforward": 1024,
                "num_queries": 50,
                "dropout": 0.1,
                "num_categories": 0,
                "use_fpn": true,
                "include_level_32": true
            }
        }
    },
    "dataset": {
        "name": "ERPBBoxDataset",
        "args": {
            "voxel_resolution": 64,
            "max_objects": 50,
            "min_bbox_size": 0.005
        }
    },
    "trainer": {
        "name": "BBoxEstimationTrainer",
        "args": {
            "max_steps": 100000,
            "batch_size_per_gpu": 16,
            "batch_split": 1,
            "optimizer": {
                "name": "AdamW",
                "args": {
                    "lr": 1e-4,
                    "weight_decay": 1e-4,
                    "betas": [0.9, 0.999]
                }
            },
            "lr_scheduler": {
                "name": "CosineAnnealingLR",
                "args": {
                    "T_max": 100000,
                    "eta_min": 1e-6
                }
            },
            "ema_rate": [0.9999],
            "mix_precision_mode": "amp",
            "mix_precision_dtype": "bfloat16",
            "grad_clip": 0.1,
            "i_print": 100,
            "i_log": 100,
            "i_sample": 500,
            "i_save": 2000,
            "lambda_center": 5.0,
            "lambda_size": 5.0,
            "lambda_rotation": 2.0,
            "lambda_confidence": 1.0,
            "lambda_giou": 5.0,
            "cost_center": 5.0,
            "cost_size": 5.0,
            "cost_confidence": 2.0,
            "cost_giou": 2.0,
            "confidence_threshold": 0.5,
            "use_diou": true,
            "aux_loss_weight": 1.0
        }
    }
}
